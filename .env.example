# Space-Track: https://www.space-track.org/auth/createAccount
SPACETRACK_USER=user
SPACETRACK_PASSWORD=pass

# PostgreSQL (Docker)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=orbital
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=orbital_data

# RustFS: основное S3-хранилище (Docker, сервис s3)
S3_RUSTFS_HOST=localhost
S3_RUSTFS_PORT=9000
S3_RUSTFS_CONSOLE_PORT=9001
S3_RUSTFS_ACCESS_KEY=orbital
S3_RUSTFS_SECRET_KEY=change-me-rustfs-key

# MinIO: локальный дубль (запуск utils/run_minio.sh, пароль не короче 8 символов)
S3_MINIO_HOST=localhost
S3_MINIO_PORT=9002
S3_MINIO_CONSOLE_PORT=9003
S3_MINIO_ACCESS_KEY=orbital
S3_MINIO_SECRET_KEY=change-me-minio-key

# Yandex Object Storage: внешний бэкап
BACKUP_S3_ENDPOINT=https://storage.yandexcloud.net
BACKUP_S3_REGION=ru-central1
BACKUP_S3_BUCKET=your-bucket-name
BACKUP_S3_ACCESS_KEY=ACCESS_KEY
BACKUP_S3_SECRET_KEY=SECRET_KEY
BACKUP_SOURCE=RUSTFS
BACKUP_MAX_MB=800
BACKUP_KEEP_DUMPS=7
